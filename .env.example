# Provider usado pelo llm_client: mock | anthropic | bedrock | litellm
FINGUARD_LLM_PROVIDER=mock

# Usado apenas quando FINGUARD_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Usado apenas quando FINGUARD_LLM_PROVIDER=bedrock (usa as credenciais padrão da AWS CLI/boto3)
AWS_REGION=us-east-1

# Usado apenas quando FINGUARD_LLM_PROVIDER=litellm (AI Gateway do desafio Future Minds)
LITELLM_TOKEN=
LITELLM_BASE_URL=https://dx-ai-gateway.platform.sbox.zupcloud.corp

# Model id — preferível passar via CLI (--model) em benchmarks
# Ex.: claude-haiku-4-5 | anthropic.claude-haiku-4-5-20251001-v1:0 | bedrock-anthropic-claude-haiku-4-5
FINGUARD_LLM_MODEL=claude-haiku-4-5
