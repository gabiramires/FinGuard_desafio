# Provider usado pelo llm_client: mock | anthropic | bedrock
FINGUARD_LLM_PROVIDER=mock

# Usado apenas quando FINGUARD_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Usado apenas quando FINGUARD_LLM_PROVIDER=bedrock (usa as credenciais padrão da AWS CLI/boto3)
AWS_REGION=us-east-1

# Model id — preferível passar via CLI (--model) em benchmarks
# Ex.: claude-sonnet-4-20250514 | anthropic.claude-3-5-sonnet-20241022-v2:0
FINGUARD_LLM_MODEL=
